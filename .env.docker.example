# Local DB HR Docker Environment
NEXT_PUBLIC_APP_VERSION=v0.13.0-beta

# App
APP_PORT=3000
APP_URL=http://localhost:3000
AUTH_SECRET=change_this_to_a_long_random_secret
SESSION_SECRET=change_this_to_a_long_random_session_secret_min_32_chars

# PostgreSQL
POSTGRES_DB=local_db_hr
POSTGRES_USER=local_db_hr_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# Ed25519 public key for D3HR. licence verification (public key only; auto-filled from config/license-public-key.pem on install)
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAnhJH0RRzWPsAJ82n2+YGvadMwIHfX+OzvnSlx6XQWPI=\n-----END PUBLIC KEY-----"

# Default administrator (first install only; skipped when an administrator already exists)
DEFAULT_ADMIN_EMAIL=admin@local-db-hr.local
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_PASSWORD=
