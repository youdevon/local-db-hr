# PostgreSQL connection (Supabase self-hosted or any Postgres)
DATABASE_URL=

# Iron session encryption (use a long random string, 32+ characters)
SESSION_SECRET=

APP_VERSION=v0.8.1-beta
NEXT_PUBLIC_APP_VERSION=v0.8.1-beta

# Optional: comma-separated LAN origins allowed to access Next.js dev assets/HMR
# Example: ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.1.50

# Ed25519 public key (SPKI PEM) for verifying D3HR. signed licence keys. Never put the private signing key here.
# Install scripts auto-fill from config/license-public-key.pem when blank. Paste full PEM or single line with \n escapes.
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAnhJH0RRzWPsAJ82n2+YGvadMwIHfX+OzvnSlx6XQWPI=\n-----END PUBLIC KEY-----"

# Default administrator (created once on first install when no admin exists; never overwritten on upgrade)
DEFAULT_ADMIN_EMAIL=admin@local-db-hr.local
DEFAULT_ADMIN_NAME=System Administrator
# Leave blank to generate a secure one-time temporary password printed to install logs
DEFAULT_ADMIN_PASSWORD=

# Provider-only manual licence controls (unsafe for client admin access). Keep false in normal deployments.
ENABLE_PROVIDER_LICENSE_CONTROLS=false

# SMTP email notification encryption key (server-side only).
EMAIL_SETTINGS_ENCRYPTION_KEY=

# Internal secret for protected /api/jobs/email-alerts/run endpoint.
EMAIL_JOB_SECRET=
