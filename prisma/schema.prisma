  @@index([year_start_date, year_end_date], map: "idx_leave_year_balances_year_dates")
  @@index([employee_id, contract_id], map: "idx_leave_year_balances_employee_contract")
  @@index([contract_year_number], map: "idx_leave_year_balances_year")
}
