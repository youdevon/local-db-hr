generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Application user accounts (custom auth; password_hash is server-only).
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                                                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                     String                @unique @map("email")
  password_hash                                             String                @map("password_hash")
  is_active                                                 Boolean               @default(true) @map("is_active")
  is_locked                                                 Boolean               @default(false) @map("is_locked")
  failed_login_attempts                                     Int                   @default(0) @map("failed_login_attempts")
  last_login_at                                             DateTime?             @map("last_login_at") @db.Timestamptz(6)
  last_login_ip                                             String?               @map("last_login_ip") @db.Inet
  last_login_device                                         String?               @map("last_login_device")
  created_at                                                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at                                                DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  employee_documents                                        employee_documents[]
  leave_transactions_leave_transactions_created_byTousers   leave_transactions[]  @relation("leave_transactions_created_byTousers")
  leave_transactions_leave_transactions_updated_byTousers   leave_transactions[]  @relation("leave_transactions_updated_byTousers")
  leave_year_balances_leave_year_balances_created_byTousers leave_year_balances[] @relation("leave_year_balances_created_byTousers")
  leave_year_balances_leave_year_balances_locked_byTousers  leave_year_balances[] @relation("leave_year_balances_locked_byTousers")
  leave_year_balances_leave_year_balances_updated_byTousers leave_year_balances[] @relation("leave_year_balances_updated_byTousers")
  audit_logs                                                LoginAuditLog[]
  system_audit_logs                                         SystemAuditLog[]
  profile                                                   UserProfile?

  @@index([email], map: "idx_users_email")
  @@index([is_active], map: "idx_users_is_active")
  @@index([created_at(sort: Desc)], map: "idx_users_created_at")
  @@map("users")
}

model UserProfile {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @unique @map("user_id") @db.Uuid
  full_name   String     @map("full_name")
  initials    String?    @db.VarChar(5)
  role        String     @default("Administrator") @map("role")
  department  String?    @map("department")
  created_at  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  employee_id String?    @db.Uuid
  employees   employees? @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_user_profiles_employee_id")
  @@index([department], map: "idx_user_profiles_department")
  @@index([role], map: "idx_user_profiles_role")
  @@index([user_id], map: "idx_user_profiles_user_id")
  @@map("user_profiles")
}

model LoginAuditLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String?   @map("user_id") @db.Uuid
  email_attempted   String?
  action            String    @map("action")
  success           Boolean   @default(false) @map("success")
  ip_address        String?   @map("ip_address") @db.Inet
  device_name       String?   @map("device_name")
  user_agent        String?   @map("user_agent")
  failure_reason    String?   @map("failure_reason")
  created_at        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  archived_at       DateTime? @db.Timestamptz(6)
  archive_reference String?
  retention_until   DateTime? @db.Date
  legal_hold        Boolean   @default(false)
  user              User?     @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([action], map: "idx_login_audit_logs_action")
  @@index([created_at], map: "idx_login_audit_logs_created_at")
  @@index([email_attempted], map: "idx_login_audit_logs_email_attempted")
  @@index([user_id], map: "idx_login_audit_logs_user_id")
  @@index([legal_hold], map: "idx_login_audit_logs_legal_hold")
  @@index([retention_until], map: "idx_login_audit_logs_retention_until")
  @@index([success], map: "idx_login_audit_logs_success")
  @@map("login_audit_logs")
}

model SystemAuditLog {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id            String?                    @db.Uuid
  actor_email              String?
  actor_name               String?
  module                   String
  action                   String
  target_type              String?
  target_id                String?                    @db.Uuid
  target_label             String?
  success                  Boolean                    @default(false)
  failure_reason           String?
  ip_address               String?                    @db.Inet
  device_name              String?
  user_agent               String?
  metadata                 Json?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  archived_at              DateTime?                  @db.Timestamptz(6)
  archive_reference        String?
  retention_until          DateTime?                  @db.Date
  legal_hold               Boolean                    @default(false)
  system_audit_log_changes system_audit_log_changes[]
  actor                    User?                      @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([action], map: "idx_system_audit_logs_action")
  @@index([actor_user_id], map: "idx_system_audit_logs_actor_user_id")
  @@index([created_at], map: "idx_system_audit_logs_created_at")
  @@index([module], map: "idx_system_audit_logs_module")
  @@index([success], map: "idx_system_audit_logs_success")
  @@index([target_type, target_id], map: "idx_system_audit_logs_target")
  @@index([legal_hold], map: "idx_system_audit_logs_legal_hold")
  @@index([retention_until], map: "idx_system_audit_logs_retention_until")
  @@map("system_audit_logs")
}

