/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contracts {
  id                                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                            String                @db.Uuid
  contract_number                        String?
  start_date                             DateTime              @db.Date
  end_date                               DateTime              @db.Date
  date_received                          DateTime?             @db.Date
  date_signed                            DateTime?             @db.Date
  salary                                 Decimal               @default(0) @db.Decimal(12, 2)
  gratuity                               Decimal               @default(0) @db.Decimal(12, 2)
  vacation_leave_entitlement             Decimal               @default(0) @db.Decimal(6, 2)
  sick_leave_entitlement                 Decimal               @default(0) @db.Decimal(6, 2)
  vacation_rollover_allowed              Boolean               @default(true)
  sick_rollover_allowed                  Boolean               @default(false)
  status                                 String                @default("draft")
  notes                                  String?
  created_at                             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                             DateTime              @default(now()) @db.Timestamptz(6)
  minute_number                          String?
  retirement_override_required           Boolean               @default(false)
  retirement_override_reason             String?
  retirement_override_approval_reference String?
  retirement_cutoff_date                 DateTime?             @db.Date
  contract_allowances                    contract_allowances[]
  employees                              employees             @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leave_transactions                     leave_transactions[]
  leave_year_balances                    leave_year_balances[]

  @@index([employee_id], map: "idx_contracts_employee_id")
  @@index([employee_id, start_date, end_date], map: "idx_contracts_employee_period")
  @@index([end_date], map: "idx_contracts_end_date")
  @@index([start_date], map: "idx_contracts_start_date")
  @@index([status], map: "idx_contracts_status")
  @@index([minute_number], map: "idx_contracts_minute_number")
  @@index([contract_number], map: "idx_contracts_contract_number")
  @@index([contract_number(ops: raw("gin_trgm_ops"))], map: "idx_contracts_contract_number_trgm", type: Gin)
  @@index([created_at(sort: Desc)], map: "idx_contracts_created_at")
  @@index([employee_id, created_at(sort: Desc)], map: "idx_contracts_employee_created")
  @@index([employee_id, start_date, end_date], map: "idx_contracts_employee_dates")
  @@index([minute_number(ops: raw("gin_trgm_ops"))], map: "idx_contracts_minute_number_trgm", type: Gin)
}

