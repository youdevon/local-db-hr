# Path to Ed25519 private key (PKCS #8 PEM). Used only by generate-license; never distribute to HR deployments.
LICENSE_PRIVATE_KEY_PATH=./keys/license-private.pem

# Path to Ed25519 public key (SPKI PEM). Used by verify-license and should match the HR app LICENSE_PUBLIC_KEY_PEM.
LICENSE_PUBLIC_KEY_PATH=./keys/license-public.pem

# Optional base directory for keypair output from generate-keypair
LICENSE_KEYS_DIR=./keys
